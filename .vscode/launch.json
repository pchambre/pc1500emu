{
  "version": "0.2.0",
  "configurations": [
    {
      // Attaches to an already-running pc1500emu instance (launch it
      // yourself first, e.g. via the pc1500emu target or a terminal) and
      // loads the currently-open .asm's assembled program into it.
      //
      // This is a template: point "program"/"listing" at a real
      // assembled+linked binary and its .lst (sdaslh5801 alone only
      // produces a relocatable .rel -- sdld+makebin turn that into the
      // flat binary this expects). The lh5801-asm extension's own
      // "LH5801: Assemble to BIN" command runs that whole pipeline for
      // you, and "LH5801: Debug in pc1500emu" builds an equivalent
      // configuration automatically instead of needing this filled in by
      // hand -- see README.md's "Editing disassembly output" section.
      "type": "lh5801",
      "request": "launch",
      "name": "LH5801: Attach to running pc1500emu",
      "program": "${fileDirname}/${fileBasenameNoExtension}.bin",
      "loadAddress": "4200",
      "entry": "4200",
      "listing": "${fileDirname}/${fileBasenameNoExtension}.lst",
      "sourcePath": "${file}",
      "stopOnEntry": true
    },
    {
      // Same, but also starts pc1500emu itself rather than requiring one
      // already running. Fill in romPath for your machine.
      "type": "lh5801",
      "request": "launch",
      "name": "LH5801: Launch pc1500emu and debug",
      "emulatorPath": "${workspaceFolder}/build/src/host/RelWithDebInfo/pc1500emu.exe",
      "romPath": "C:/path/to/ROM1.BIN",
      "program": "${fileDirname}/${fileBasenameNoExtension}.bin",
      "loadAddress": "4200",
      "entry": "4200",
      "listing": "${fileDirname}/${fileBasenameNoExtension}.lst",
      "sourcePath": "${file}",
      "stopOnEntry": true
    }
  ]
}
